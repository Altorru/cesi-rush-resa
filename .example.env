# ════════════════════════════════════════════════════════════
# Better Auth Starter – Environment Configuration
# ════════════════════════════════════════════════════════════

# ── Secret key for BetterAuth (REQUIRED) ───────────────────
# Use a strong, random secret. Generate one with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=<your_better_auth_secret>

# ── Application URL ───────────────────────────────────────
# Dev:  http://localhost:3000
# Prod: Your production domain
BETTER_AUTH_URL=http://localhost:3000

# ── PostgreSQL Database ───────────────────────────────────
#
# Docker (via docker-compose):
#   DATABASE_URL="postgresql://cesi_rush_resa:cesi_rush_resa_pass@db:5432/cesi_rush_resa"
#
# Local (without Docker):
#   DATABASE_URL="postgresql://<username>:<password>@localhost:5432/<db_name>?schema=public"
DATABASE_URL="postgresql://cesi_rush_resa:cesi_rush_resa_pass@db:5432/cesi_rush_resa"

# ── PostgreSQL credentials (for docker-compose) ───────────
POSTGRES_USER=cesi_rush_resa
POSTGRES_PASSWORD=cesi_rush_resa_pass
POSTGRES_DB=cesi_rush_resa

# ── Google OAuth (optional – required for social login) ───
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
